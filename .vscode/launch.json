{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Raytracer",
            "type": "cppdbg",
            "request": "launch",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/bin",
            "console": "internalConsole",
            "preLaunchTask": "Build Raytracer",
            "windows": {
                "type": "cppvsdbg",
                "program": "${workspaceFolder}/bin/raytracer_debug.exe",
                "environment": [
                    {
                        "name": "PATH",
                        "value": "${workspaceFolder}/bin;${env:PATH}"
                    }
                ]
            },
            "linux": {
                "type": "cppdbg",
                "program": "${workspaceFolder}/bin/raytracer_debug",
                "MIMode": "gdb",
                "environment": [
                    {
                        "name": "LD_LIBRARY_PATH",
                        "value": "${workspaceFolder}/bin:${env:LD_LIBRARY_PATH}"
                    }
                ]
            },
            "osx": {
                "type": "cppdbg",
                "program": "${workspaceFolder}/bin/raytracer_debug",
                "MIMode": "lldb",
                "environment": [
                    {
                        "name": "DYLD_LIBRARY_PATH",
                        "value": "/Users/serhii/Development/SDK/Vulkan/macOS/lib:${workspaceFolder}/bin:${env:DYLD_LIBRARY_PATH}"
                    }
                ]
            }
        },
